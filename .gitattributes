# Text files are stored and checked out with LF, whatever core.autocrlf says,
# so the working copy matches what agents and the .NET tools write and Git
# stops warning about line-ending conversions. .editorconfig agrees.
* text=auto eol=lf

# Batch files need CRLF to run
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tif binary
*.tiff binary
*.ico binary
*.webp binary
*.heic binary
*.heif binary
*.dng binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pri binary
*.dll binary
*.exe binary
