# Text files are stored and checked out with LF, whatever core.autocrlf says,
# so the working copy matches what agents and the .NET tools write and Git
# stops warning about line-ending conversions. .editorconfig agrees.
* text=auto eol=lf

# Batch files need CRLF to run
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tif binary
*.tiff binary
*.ico binary
*.webp binary
*.heic binary
*.heif binary
*.dng binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pri binary
*.dll binary
*.exe binary
*.pfx binary
*.msix binary
*.msixbundle binary
*.appx binary
*.zip binary
*.pdf binary
*.bin binary

# Raw photo, modern image, video and audio formats
*.cr2 binary
*.cr3 binary
*.nef binary
*.arw binary
*.raf binary
*.orf binary
*.rw2 binary
*.avif binary
*.jxl binary
*.mkv binary
*.webm binary
*.wav binary
*.mp3 binary

# Test fixtures are byte-exact: no line-ending conversion, whatever the extension
tests/**/Fixtures/** -text

# Videos in the docs live in Git LFS, so a clone stays small
docs/**/*.mp4 filter=lfs diff=lfs merge=lfs -text

# The Store screenshots in the docs live in Git LFS too
docs/store/screenshots/**/*.png filter=lfs diff=lfs merge=lfs -text
