<Project Sdk="Microsoft.NET.Sdk">
  <!--
    xUnit v3 on Microsoft.Testing.Platform: the project builds to an executable
    test host, and dotnet test runs it (global.json selects the runner).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TenLapseWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(TenLapseWindowsMinVersion)</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <!-- Unpackaged, on the installed Windows App Runtime 2, like the Debug app. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- The test host is a Windows App SDK executable: the metapackage brings the runtime reference and the bootstrapper. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The tests cannot reference the App exe (NETSDK1151 against the self-contained Release App, PR #61). The export failure sentences, the encoder
    section of Copy diagnostics and the Output panel's view of the probe live in App files that need only Media and Presentation, so they are compiled in here
    to be tested.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\TenLapse.App\Services\VideoExportErrorMapper.cs" Link="Linked\VideoExportErrorMapper.cs" />
    <Compile Include="..\..\src\TenLapse.App\Services\PowerRequestKeepAwake.cs" Link="Linked\PowerRequestKeepAwake.cs" />
    <Compile Include="..\..\src\TenLapse.App\Services\EncoderDiagnostics.cs" Link="Linked\EncoderDiagnostics.cs" />
    <Compile Include="..\..\src\TenLapse.App\Services\EncoderOutputCapabilities.cs" Link="Linked\EncoderOutputCapabilities.cs" />
    <Compile Include="..\..\src\TenLapse.App\Services\ProjectVideoExporter.cs" Link="Linked\ProjectVideoExporter.cs" />
  </ItemGroup>

  <!-- The photo fixtures (docs in Fixtures/README.md) are read from the test host's folder. -->
  <ItemGroup>
    <None Update="Fixtures\Photos\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The capture-time fixtures (cut real files, docs in Ordering/Fixtures/README.md), read from the test host's folder. -->
  <ItemGroup>
    <None Update="Ordering\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TenLapse.Core\TenLapse.Core.csproj" />
    <ProjectReference Include="..\..\src\TenLapse.Media\TenLapse.Media.csproj" />
    <ProjectReference Include="..\..\src\TenLapse.Presentation\TenLapse.Presentation.csproj" />
  </ItemGroup>
</Project>
