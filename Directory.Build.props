<Project>
  <!-- Shared by every project in the repository. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- MSBuild, SDK, Win2D and XAML warnings fail a plain dotnet build too, as they do in the gate. -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <!-- A build offline or with a low or moderate advisory must still work; high and critical (NU1903, NU1904) stay errors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Company>Sven Borden</Company>
    <Product>10Lapse</Product>
  </PropertyGroup>

  <!--
    A Windows project built on its own (dotnet build src/TenLapse.App, or dotnet
    test on tests/TenLapse.Tests) would default to AnyCPU: Win2D warns
    (WIN2D0001) and the test host crashes in the Windows App SDK bootstrapper.
    Default it to x64; Core stays Any CPU.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'TenLapse.Core' and '$(Platform)' == ''">
    <Platform>x64</Platform>
  </PropertyGroup>

  <!-- Windows projects (App, Media, Tests) take their target framework from here. -->
  <PropertyGroup>
    <TenLapseWindowsTargetFramework>net10.0-windows10.0.26100.0</TenLapseWindowsTargetFramework>
    <TenLapseWindowsMinVersion>10.0.17763.0</TenLapseWindowsMinVersion>
  </PropertyGroup>
</Project>
