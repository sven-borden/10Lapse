<Project Sdk="Microsoft.NET.Sdk">
  <!--
    View models and the service interfaces they need. Plain net10.0 like Core (docs/STATUS.md, Decisions): no
    WinUI types, so the tests can reference it without the App exe. The App implements the services.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The Strings/*.resx files are English, the neutral language (#39): English reads them from this assembly. For a regional English such as en-US, ResourceManager looks for a satellite once, finds none and remembers it. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TenLapse.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TenLapse.Core\TenLapse.Core.csproj" />
  </ItemGroup>
</Project>
