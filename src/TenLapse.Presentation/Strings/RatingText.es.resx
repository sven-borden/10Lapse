<?xml version="1.0" encoding="utf-8"?>
<!--
  Spanish (es) translation of RatingText.resx (#117). The English file's comments are the brief for each key.
  One neutral Spanish for Spain and Latin America. Informal address ("tú"), as Windows 11 writes Spanish. Windows'
  Spanish terms (archivo, carpeta, Configuración, equipo); "vídeo" as Windows and the Store write it in es-ES. UI labels
  named inside a sentence stand in quotation marks (“…”). Spanish needs no _many form here: with digits a million takes
  no "de" ("1.000.000 fotos"), so every sentence is the same as _other.
-->
<root>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <data name="CardTitle" xml:space="preserve">
    <value>Comentarios</value>
  </data>
  <data name="CardCaptionFormat" xml:space="preserve">
    <value>“{0}” abre su página en Microsoft Store. “{1}” abre GitHub en tu navegador. 10Lapse no envía nada por su cuenta.</value>
  </data>
  <data name="RateButton" xml:space="preserve">
    <value>Calificar 10Lapse</value>
  </data>
  <data name="FeedbackButton" xml:space="preserve">
    <value>Enviar comentarios</value>
  </data>
  <data name="RateTip" xml:space="preserve">
    <value>Abre Microsoft Store</value>
  </data>
  <data name="FeedbackTip" xml:space="preserve">
    <value>Abre GitHub en tu navegador</value>
  </data>
  <data name="RateFailed" xml:space="preserve">
    <value>No se pudo abrir Microsoft Store. Ábrela desde el menú Inicio y busca 10Lapse para calificarla.</value>
  </data>
  <data name="FeedbackFailed" xml:space="preserve">
    <value>No se pudo abrir el navegador. Ve a github.com/sven-borden/10Lapse/issues para enviar tus comentarios.</value>
  </data>
</root>
