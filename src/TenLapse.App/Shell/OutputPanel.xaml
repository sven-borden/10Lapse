<?xml version="1.0" encoding="utf-8"?>
<!--
  The Output section of the inspector (#23), after the prototype's Output section in docs/design/canvas/Main.dc.html:
  a Body strong heading, Resolution, Format and Quality as selects (Card fill, Control Stroke border, 4 px corners,
  32 px), and the estimated file size in Caption Secondary, between 16 px of padding above and below and a divider
  at the bottom. Inspector sections stack in a column inside ShellView's InspectorRegion.

  With Animated GIF chosen (#51), Size and Frame rate stand where Resolution and Quality stand for a video, and the
  estimate is a range. The lists hold only what this PC confirmed it can encode (OutputPanelViewModel): a size it cannot export is left
  out, never disabled, and one line under the lists says why. Until the startup probe has answered, a quiet line
  replaces the lists in a block as tall as they are, so nothing moves while the lists are still empty (the note and
  the notice add lines when they appear). The code-behind raises screen reader notifications for the pending state,
  the lists appearing and the notice, since a Collapsed to Visible flip does not raise a live region event.
  No amber here: the selects take their colors from the control overrides (ControlOverrides.xaml).

  Narrow (#36; the canvas's repeat(3, 1fr)): the three selects stand in one row, 12 px apart, and the bottom divider goes,
  because the section is alone under its tab. ShellView calls SetNarrow. The three blocks always sit in a 3-column grid:
  wide, each spans all three columns on its own row; narrow, each takes one column of row 0.
-->
<UserControl
  x:Class="TenLapse.Shell.OutputPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:presentation="using:TenLapse.Presentation">

  <UserControl.Resources>
    <!-- A select: 32 px, 4 px corners, 8 px side padding, as wide as the inspector's column. -->
    <Style x:Key="OutputSelectStyle" TargetType="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
      <Setter Property="Padding" Value="{StaticResource PaddingSelect}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
  </UserControl.Resources>

  <Border
    x:Name="Section"
    Padding="0,16,0,16"
    BorderBrush="{ThemeResource DividerBrush}"
    BorderThickness="0,0,0,1">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="LayoutStates">
        <VisualState x:Name="Wide" />
        <VisualState x:Name="Narrow">
          <VisualState.Setters>
            <Setter Target="Section.BorderThickness" Value="0" />
            <Setter Target="PendingBlock.MinHeight" Value="{StaticResource OutputPendingNarrowMinHeight}" />
            <Setter Target="SelectGrid.RowSpacing" Value="0" />
            <Setter Target="ResolutionBlock.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="FormatBlock.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="FormatBlock.(Grid.Row)" Value="0" />
            <Setter Target="FormatBlock.(Grid.Column)" Value="1" />
            <Setter Target="QualityBlock.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="QualityBlock.(Grid.Row)" Value="0" />
            <Setter Target="QualityBlock.(Grid.Column)" Value="2" />
            <Setter Target="GifSizeBlock.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="GifRateBlock.(Grid.ColumnSpan)" Value="1" />
            <Setter Target="GifRateBlock.(Grid.Row)" Value="0" />
            <Setter Target="GifRateBlock.(Grid.Column)" Value="2" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <StackPanel Spacing="{StaticResource SpacingMd}">
      <TextBlock
        AutomationProperties.HeadingLevel="Level2"
        Style="{StaticResource BodyStrongTextStyle}"
        Text="{x:Bind presentation:OutputText.Heading}" />

      <!--
        Pending: as tall as the three lists and the estimate (3 x 54 px, 28 px, three 12 px gaps), so the lists appear without moving anything
        (the note and the notice, when there are any, add 1 to 3 lines under them). Plain Ink Secondary text, no progress bar: nothing here is an export.
      -->
      <Border x:Name="PendingBlock" MinHeight="214" Visibility="{x:Bind ViewModel.IsPending, Mode=OneWay}">
        <TextBlock
          x:Name="PendingText"
          Foreground="{ThemeResource InkSecondaryBrush}"
          Style="{StaticResource BodyTextStyle}"
          Text="{x:Bind ViewModel.Status, Mode=OneWay}"
          TextWrapping="Wrap" />
      </Border>

      <StackPanel
        x:Name="Lists"
        Spacing="{StaticResource SpacingMd}"
        Visibility="{x:Bind ViewModel.IsSettled, Mode=OneWay}">
        <Grid x:Name="SelectGrid" ColumnSpacing="{StaticResource SpacingMd}" RowSpacing="{StaticResource SpacingMd}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel
            x:Name="ResolutionBlock"
            Grid.ColumnSpan="3"
            Spacing="6"
            Visibility="{x:Bind ViewModel.ShowsVideoOptions, Mode=OneWay}">
            <TextBlock
              x:Name="ResolutionLabel"
              Foreground="{ThemeResource InkSecondaryBrush}"
              Style="{StaticResource CaptionTextStyle}"
              Text="{x:Bind presentation:OutputText.ResolutionLabel}" />
            <ComboBox
              x:Name="ResolutionList"
              AutomationProperties.Name="{x:Bind presentation:OutputText.ResolutionLabel}"
              ItemsSource="{x:Bind ViewModel.Resolutions, Mode=OneWay}"
              SelectedItem="{x:Bind ViewModel.SelectedResolution, Mode=TwoWay}"
              Style="{StaticResource OutputSelectStyle}" />
          </StackPanel>
          <StackPanel x:Name="FormatBlock" Grid.Row="1" Grid.ColumnSpan="3" Spacing="6">
            <TextBlock
              x:Name="FormatLabel"
              Foreground="{ThemeResource InkSecondaryBrush}"
              Style="{StaticResource CaptionTextStyle}"
              Text="{x:Bind presentation:OutputText.FormatLabel}" />
            <ComboBox
              x:Name="FormatList"
              AutomationProperties.Name="{x:Bind presentation:OutputText.FormatLabel}"
              ItemsSource="{x:Bind ViewModel.Formats, Mode=OneWay}"
              SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}"
              Style="{StaticResource OutputSelectStyle}" />
          </StackPanel>
          <StackPanel
            x:Name="QualityBlock"
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Spacing="6"
            Visibility="{x:Bind ViewModel.ShowsVideoOptions, Mode=OneWay}">
            <TextBlock
              x:Name="QualityLabel"
              Foreground="{ThemeResource InkSecondaryBrush}"
              Style="{StaticResource CaptionTextStyle}"
              Text="{x:Bind presentation:OutputText.QualityLabel}" />
            <ComboBox
              x:Name="QualityList"
              AutomationProperties.Name="{x:Bind presentation:OutputText.QualityLabel}"
              ItemsSource="{x:Bind ViewModel.Qualities}"
              SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}"
              Style="{StaticResource OutputSelectStyle}" />
          </StackPanel>

          <!--
            Animated GIF (#51): its own size and frame rate lists take the places of Resolution and Quality, which do not
            apply to a GIF and are absent (not disabled) while it is chosen. Format stays in the middle.
          -->
          <StackPanel
            x:Name="GifSizeBlock"
            Grid.ColumnSpan="3"
            Spacing="6"
            Visibility="{x:Bind ViewModel.ShowsGifOptions, Mode=OneWay}">
            <TextBlock
              x:Name="GifSizeLabel"
              Foreground="{ThemeResource InkSecondaryBrush}"
              Style="{StaticResource CaptionTextStyle}"
              Text="{x:Bind presentation:OutputText.GifSizeLabel}" />
            <ComboBox
              x:Name="GifSizeList"
              AutomationProperties.Name="{x:Bind presentation:OutputText.GifSizeLabel}"
              ItemsSource="{x:Bind ViewModel.GifSizes, Mode=OneWay}"
              SelectedItem="{x:Bind ViewModel.SelectedGifSize, Mode=TwoWay}"
              Style="{StaticResource OutputSelectStyle}" />
          </StackPanel>
          <StackPanel
            x:Name="GifRateBlock"
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Spacing="6"
            Visibility="{x:Bind ViewModel.ShowsGifOptions, Mode=OneWay}">
            <TextBlock
              x:Name="GifRateLabel"
              Foreground="{ThemeResource InkSecondaryBrush}"
              Style="{StaticResource CaptionTextStyle}"
              Text="{x:Bind presentation:OutputText.GifRateLabel}" />
            <ComboBox
              x:Name="GifRateList"
              AutomationProperties.Name="{x:Bind presentation:OutputText.GifRateLabel}"
              ItemsSource="{x:Bind ViewModel.GifRates}"
              SelectedItem="{x:Bind ViewModel.SelectedGifRate, Mode=TwoWay}"
              Style="{StaticResource OutputSelectStyle}" />
          </StackPanel>
        </Grid>

        <!-- "About 180 MB": empty without photos. No automation name of its own: a screen reader reads the text itself. -->
        <TextBlock
          x:Name="EstimateText"
          Foreground="{ThemeResource InkSecondaryBrush}"
          Style="{StaticResource CaptionTabularTextStyle}"
          Text="{x:Bind ViewModel.EstimatedSize, Mode=OneWay}"
          Visibility="{x:Bind ViewModel.HasEstimate, Mode=OneWay}" />

        <!-- Why a size is missing or slower ("This PC's graphics hardware exports up to 1440p."). One line, shown only then. -->
        <TextBlock
          x:Name="NoteText"
          Foreground="{ThemeResource InkSecondaryBrush}"
          Style="{StaticResource CaptionTextStyle}"
          Text="{x:Bind ViewModel.Note, Mode=OneWay}"
          TextWrapping="Wrap"
          Visibility="{x:Bind ViewModel.HasNote, Mode=OneWay}" />

        <!-- What the panel changed on its own ("4K can't be exported on this PC with these settings, so 1440p is selected."). -->
        <TextBlock
          x:Name="NoticeText"
          Foreground="{ThemeResource InkBrush}"
          Style="{StaticResource CaptionTextStyle}"
          Text="{x:Bind ViewModel.Notice, Mode=OneWay}"
          TextWrapping="Wrap"
          Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}" />

        <!-- Stores the shown settings in place of the earlier choice. Picking the entry that is already shown cannot do it: a ComboBox reports no change. -->
        <Button
          x:Name="KeepSelectedButton"
          HorizontalAlignment="Left"
          Click="OnKeepSelected"
          Content="{x:Bind presentation:OutputText.KeepSelected}"
          Visibility="{x:Bind ViewModel.HasReplacement, Mode=OneWay}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
