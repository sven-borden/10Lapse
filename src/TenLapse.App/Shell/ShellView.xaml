<?xml version="1.0" encoding="utf-8"?>
<!--
  The app shell (#28), the whole content of MainWindow. It is a UserControl, not the window's own XAML, because
  visual state triggers only run inside a control: the Empty and Editing states here, #36's narrow layout later.
  Laid out after the prototype in docs/design/canvas/Main.dc.html and DESIGN.md section 5:

    Title bar    40 px on Mica: app icon, "10Lapse" in Caption, the project name in Ink Secondary, a dot
                 while there are unsaved changes, the system caption buttons.
    Command bar  48 px on Mica: subtle buttons left; Settings and the amber Export button right.
    Body         three states from ShellViewModel (ShowsEmpty, ShowsEditing, IsSettingsOpen):
                 Empty    EmptyRegion, the first-launch drop zone (#29).
                 Editing  the Layer surface with StageRegion (PreviewRegion, TransportRegion, FilmstripRegion)
                          and InspectorPane (InspectorRegion) docked right at 320 px.
                 Settings SettingsPage (SettingsView.xaml) over the whole body; the command bar shows only Back.
                 InfoBarLayer floats over the top of the stage in every state and never moves the layout.

  The body grid is 2 x 2 so #36 can fold the inspector under the stage below 1,000 px with one visual state:
  InspectorPane to Grid.Row 1, Grid.Column 0, Width Auto, Height NarrowPanelHeight, BorderThickness 0,1,0,0 and
  Margin 0 (its 0,1,0,0 keeps it off the Layer's top divider when docked right; under the stage it would leave a
  1 px gap above its own divider).
  The stage and the InfoBar layer stay in cell (0, 0) and need no change.

  Unbuilt actions are absent, not disabled (CLAUDE.md): the command bar holds Add photos (#12), New project and
  Settings for now, with a commented slot for each later button. Buttons for a project go in ProjectCommands (left), the Export
  button in WorkCommands (right): the Settings state hides both and shows Back.
-->
<UserControl
  x:Class="TenLapse.Shell.ShellView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="using:TenLapse.Core"
  xmlns:presentation="using:TenLapse.Presentation"
  xmlns:services="using:TenLapse.Presentation.Services"
  xmlns:shell="using:TenLapse.Shell">

  <!--
    Drag and drop (#12): files and folders dropped anywhere on the window are imported (ShellView.xaml.cs). The
    transparent background makes the whole window a drop target; it paints nothing, so Mica shows through. The
    first-launch drop zone (#29) in EmptyRegion only shows the drag-over look; the handling stays here and tells it.
  -->
  <Grid
    x:Name="ShellRoot"
    AllowDrop="True"
    Background="Transparent"
    DragEnter="OnDragEnter"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <VisualStateManager.VisualStateGroups>
      <!--
        Empty, Editing or Settings: exactly one is active (ShellViewModel.ShowsEmpty, ShowsEditing, IsSettingsOpen).
        #36 adds its own group beside this one for the narrow layout.
      -->
      <VisualStateGroup x:Name="ProjectStates">
        <VisualState x:Name="Empty">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind ViewModel.ShowsEmpty, Mode=OneWay}" />
          </VisualState.StateTriggers>
        </VisualState>
        <!--
          The Settings page covers the body; the command bar trades its buttons for Back. The InfoBar layer spans both
          body columns so a bar centers on the page, which covers the inspector's column too, and starts below the
          page's title instead of over it.
        -->
        <VisualState x:Name="Settings">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind ViewModel.IsSettingsOpen, Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="EmptyRegion.Visibility" Value="Collapsed" />
            <Setter Target="SettingsPage.Visibility" Value="Visible" />
            <Setter Target="ProjectCommands.Visibility" Value="Collapsed" />
            <Setter Target="WorkCommands.Visibility" Value="Collapsed" />
            <Setter Target="BackButton.Visibility" Value="Visible" />
            <Setter Target="InfoBarLayer.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="InfoBarLayer.Margin" Value="{StaticResource InfoBarSettingsHostMargin}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Editing">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind ViewModel.ShowsEditing, Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="EmptyRegion.Visibility" Value="Collapsed" />
            <Setter Target="EditingSurface.Visibility" Value="Visible" />
            <Setter Target="StageRegion.Visibility" Value="Visible" />
            <Setter Target="InspectorPane.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <!-- An inactive window dims its title: the app name joins the project name in Ink Secondary. -->
      <VisualStateGroup x:Name="WindowStates">
        <VisualState x:Name="WindowActive" />
        <VisualState x:Name="WindowInactive">
          <VisualState.Setters>
            <Setter Target="AppNameText.Foreground" Value="{ThemeResource InkSecondaryBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- Where Mica is not available (Windows 10), the Mica token instead. -->
    <Border x:Name="MicaFallback" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource MicaBrush}" />

    <!--
      The drag region (Window.SetTitleBar): the title bar and the command bar, the one Mica band at the top.
      MainWindow carves the command bar's controls out of it as passthrough rectangles and keeps them in step
      with the layout, so empty bar space moves the window and the buttons still click.
    -->
    <Border x:Name="DragRegion" Grid.Row="0" Grid.RowSpan="2" />

    <!--
      Title bar: nothing interactive (it is all drag region). The inset columns keep clear of the system caption
      buttons; MainWindow sizes them from AppWindow.TitleBar.
    -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Height="{StaticResource TitleBarHeight}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="TitleBarLeftInset" Width="0" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="TitleBarRightInset" Width="0" />
      </Grid.ColumnDefinitions>
      <!--
        The system draws its caption buttons 32 px tall (AppWindowTitleBar offers 32 or 48, not 40), so the
        title content is centered on their row, the top 32 px, and the strip keeps the spec's 40 px.
      -->
      <StackPanel
        Grid.Column="1"
        Height="32"
        Padding="16,0,0,0"
        VerticalAlignment="Top"
        Orientation="Horizontal"
        Spacing="{StaticResource SpacingMd}">
        <!-- The app icon is the Store tile's unplated asset, so #37's icon arrives here by itself. -->
        <Image
          Width="16"
          Height="16"
          VerticalAlignment="Center"
          Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
        <TextBlock
          x:Name="AppNameText"
          VerticalAlignment="Center"
          Style="{StaticResource CaptionTextStyle}"
          Text="{x:Bind core:Product.Name}" />
        <StackPanel
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="{StaticResource SpacingSm}"
          Visibility="{x:Bind ViewModel.ShowsProjectName, Mode=OneWay}">
          <TextBlock
            x:Name="ProjectNameText"
            MaxWidth="360"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionSecondaryTextStyle}"
            Text="{x:Bind ViewModel.CurrentProject.Name, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
          <Ellipse
            x:Name="UnsavedDot"
            Width="6"
            Height="6"
            VerticalAlignment="Center"
            AutomationProperties.Name="Unsaved changes"
            Fill="{ThemeResource InkSecondaryBrush}"
            Visibility="{x:Bind ViewModel.HasUnsavedChanges, Mode=OneWay}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!--
      Command bar. Its buttons are subtle (DESIGN.md, Buttons): the Button keys below make every plain Button in
      it transparent with an Ink wash on hover. ExportButtonStyle carries its own brushes, so the slot for it on
      the right is not affected. High contrast keeps the system button colors.
    -->
    <Grid
      x:Name="CommandBarRegion"
      Grid.Row="1"
      Height="{StaticResource CommandBarHeight}"
      Padding="12,0,12,0">
      <Grid.Resources>
        <ResourceDictionary>
          <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
              <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillHoverColor}" />
              <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtleFillPressedColor}" />
              <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource InkColor}" />
              <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource InkColor}" />
              <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource InkSecondaryColor}" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
              <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillHoverColor}" />
              <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtleFillPressedColor}" />
              <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
              <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource InkColor}" />
              <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource InkColor}" />
              <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource InkSecondaryColor}" />
            </ResourceDictionary>
          </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
      </Grid.Resources>

      <!-- On the Settings page the bar holds only Back (Escape, Alt+Left and the mouse back button too, the last in ShellView.xaml.cs). -->
      <Button
        x:Name="BackButton"
        Height="{StaticResource ControlHeight}"
        Padding="{StaticResource PaddingButtonSubtle}"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        AutomationProperties.Name="{x:Bind presentation:ProjectText.Back}"
        Command="{x:Bind ViewModel.CloseSettingsCommand}"
        KeyboardAcceleratorPlacementMode="Hidden"
        Visibility="Collapsed">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Escape" />
          <KeyboardAccelerator Key="Left" Modifiers="Menu" />
        </Button.KeyboardAccelerators>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
          <!-- Segoe Fluent Icons "Back", the prototype's left arrow. -->
          <FontIcon
            VerticalAlignment="Center"
            FontSize="16"
            Glyph="&#xE72B;" />
          <TextBlock VerticalAlignment="Center" Text="{x:Bind presentation:ProjectText.Back}" />
        </StackPanel>
      </Button>

      <StackPanel
        x:Name="ProjectCommands"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="{StaticResource SpacingXs}">
        <!--
          Add photos (#12): a subtle button with the plus icon, always visible (the Settings state hides the whole
          panel). It opens a menu: Choose folder…, Choose photos…, and the Include subfolders toggle, which also
          applies to folders dropped on the window.
        -->
        <Button
          x:Name="AddPhotosButton"
          Height="{StaticResource ControlHeight}"
          Padding="{StaticResource PaddingButtonSubtle}"
          AutomationProperties.Name="{x:Bind presentation:ProjectText.AddPhotos}">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuFlyoutItem Command="{x:Bind Import.ChooseFolderCommand}" Text="{x:Bind presentation:ProjectText.ChooseFolder}">
                <MenuFlyoutItem.Icon>
                  <!-- Segoe Fluent Icons "Folder". -->
                  <FontIcon Glyph="&#xE8B7;" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Command="{x:Bind Import.ChoosePhotosCommand}" Text="{x:Bind presentation:ProjectText.ChoosePhotos}">
                <MenuFlyoutItem.Icon>
                  <!-- Segoe Fluent Icons "Photo2". -->
                  <FontIcon Glyph="&#xEB9F;" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator />
              <ToggleMenuFlyoutItem IsChecked="{x:Bind Import.IncludeSubfolders, Mode=TwoWay}" Text="{x:Bind presentation:ProjectText.IncludeSubfolders}" />
            </MenuFlyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
            <!-- Segoe Fluent Icons "Add", the prototype's plus. -->
            <FontIcon
              VerticalAlignment="Center"
              FontSize="16"
              Glyph="&#xE710;" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind presentation:ProjectText.AddPhotos}" />
          </StackPanel>
        </Button>
        <!-- Slot: Sort (#15). "Sort: Capture time" with a chevron, visible with a project. -->
        <!--
          Ctrl+N (#38) goes on ShellRoot as a KeyboardAccelerator bound to NewProjectCommand, not on this button:
          an accelerator on a collapsed button does not fire, and this one is collapsed without a project.
        -->
        <Button
          x:Name="NewProjectButton"
          Height="{StaticResource ControlHeight}"
          Padding="{StaticResource PaddingButtonSubtle}"
          AutomationProperties.Name="New project"
          Command="{x:Bind ViewModel.NewProjectCommand}"
          Visibility="{x:Bind ViewModel.ShowsProjectName, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
            <!--
              The prototype's "new page" icon (its 1.5 px strokes drawn as a filled outline, even-odd). An
              IconElement takes the button's Foreground, so hover, pressed, disabled and high contrast follow.
              Every command bar icon is one: a PathIcon like this, or a FontIcon with a Segoe Fluent Icons glyph
              at FontSize 16 (Add photos, #12: &#xE710;), never a Path with a brush of its own.
            -->
            <PathIcon
              Width="16"
              Height="16"
              VerticalAlignment="Center"
              Data="F0 M4.5 1.25H9A0.75 0.75 0 0 1 9.53 1.47L13.53 5.47A0.75 0.75 0 0 1 13.75 6V12.5A2.25 2.25 0 0 1 11.5 14.75H4.5A2.25 2.25 0 0 1 2.25 12.5V3.5A2.25 2.25 0 0 1 4.5 1.25Z M4.5 2.75H8.25V6.75H12.25V12.5A0.75 0.75 0 0 1 11.5 13.25H4.5A0.75 0.75 0 0 1 3.75 12.5V3.5A0.75 0.75 0 0 1 4.5 2.75Z M9.75 3.81L11.19 5.25H9.75Z M7.25 8.5A0.75 0.75 0 0 1 8.75 8.5V9.25H9.5A0.75 0.75 0 0 1 9.5 10.75H8.75V11.5A0.75 0.75 0 0 1 7.25 11.5V10.75H6.5A0.75 0.75 0 0 1 6.5 9.25H7.25Z" />
            <TextBlock VerticalAlignment="Center" Text="New project" />
          </StackPanel>
        </Button>
        <!--
          Import progress (#12): a 16 px ring (the indicator color, from the ProgressRing override), "Adding 1,240 of
          5,000 photos…" and Cancel, while an import runs. Indeterminate while the photos are listed, then it fills.
        -->
        <StackPanel
          x:Name="ImportProgress"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="{StaticResource SpacingSm}"
          Visibility="{x:Bind Import.IsImporting, Mode=OneWay}">
          <ProgressRing
            Width="16"
            Height="16"
            MinWidth="16"
            MinHeight="16"
            VerticalAlignment="Center"
            IsActive="{x:Bind Import.IsImporting, Mode=OneWay}"
            IsIndeterminate="{x:Bind Import.IsProgressIndeterminate, Mode=OneWay}"
            Maximum="100"
            Value="{x:Bind Import.ProgressPercent, Mode=OneWay}" />
          <TextBlock
            x:Name="ImportProgressText"
            VerticalAlignment="Center"
            Foreground="{ThemeResource InkSecondaryBrush}"
            Style="{StaticResource BodyTabularTextStyle}"
            Text="{x:Bind Import.ProgressText, Mode=OneWay}" />
          <Button
            x:Name="CancelImportButton"
            Height="{StaticResource ControlHeight}"
            Padding="{StaticResource PaddingButtonSubtle}"
            AutomationProperties.Name="{x:Bind presentation:ProjectText.ImportCancelName}"
            Command="{x:Bind Import.CancelCommand}"
            Content="{x:Bind presentation:ProjectText.Cancel}" />
        </StackPanel>
      </StackPanel>

      <StackPanel
        x:Name="WorkCommands"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="{StaticResource SpacingSm}">
        <!-- Settings: a 32 x 32 subtle icon button that opens the Settings page (a page, not a dialog). -->
        <Button
          x:Name="SettingsButton"
          Width="{StaticResource ControlHeight}"
          Height="{StaticResource ControlHeight}"
          Padding="0"
          AutomationProperties.Name="{x:Bind presentation:ProjectText.SettingsButton}"
          Command="{x:Bind ViewModel.OpenSettingsCommand}"
          ToolTipService.ToolTip="{x:Bind presentation:ProjectText.SettingsButton}">
          <!-- The prototype's sliders icon: its 1.5 px strokes as filled capsules and rings (nonzero, rings wound against). -->
          <PathIcon
            Width="16"
            Height="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Data="F1 M2.5 4.25H8.5A0.75 0.75 0 0 1 8.5 5.75H2.5A0.75 0.75 0 0 1 2.5 4.25Z M12.5 4.25H13.5A0.75 0.75 0 0 1 13.5 5.75H12.5A0.75 0.75 0 0 1 12.5 4.25Z M2.5 10.25H3.5A0.75 0.75 0 0 1 3.5 11.75H2.5A0.75 0.75 0 0 1 2.5 10.25Z M7.5 10.25H13.5A0.75 0.75 0 0 1 13.5 11.75H7.5A0.75 0.75 0 0 1 7.5 10.25Z M10.5 2.5A2.5 2.5 0 1 1 10.5 7.5A2.5 2.5 0 1 1 10.5 2.5Z M10.5 4A1 1 0 1 0 10.5 6A1 1 0 1 0 10.5 4Z M5.5 8.5A2.5 2.5 0 1 1 5.5 13.5A2.5 2.5 0 1 1 5.5 8.5Z M5.5 10A1 1 0 1 0 5.5 12A1 1 0 1 0 5.5 10Z" />
        </Button>
        <!-- Slot: Export video (#24). <Button Style="{StaticResource ExportButtonStyle}" />, the one amber button. -->
      </StackPanel>
    </Grid>

    <!-- Body: a 2 x 2 grid, see the comment at the top. -->
    <Grid x:Name="Body" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Empty: the first-launch drop zone (#29, FirstLaunchView.xaml), on Mica, 16 px in from the window edges. -->
      <Grid
        x:Name="EmptyRegion"
        Grid.RowSpan="2"
        Grid.ColumnSpan="2"
        Padding="16,0,16,16">
        <shell:FirstLaunchView x:Name="FirstLaunch" />
      </Grid>

      <!-- Editing: the Layer surface for the stage and the inspector, separated from Mica by one divider. -->
      <Border
        x:Name="EditingSurface"
        Grid.RowSpan="2"
        Grid.ColumnSpan="2"
        Background="{ThemeResource LayerBrush}"
        BorderBrush="{ThemeResource DividerBrush}"
        BorderThickness="0,1,0,0"
        Visibility="Collapsed" />

      <!-- Stage: 20 px padding, 12 px between the preview, the transport and the filmstrip. -->
      <Grid
        x:Name="StageRegion"
        Grid.Row="0"
        Grid.Column="0"
        Margin="0,1,0,0"
        Padding="{StaticResource PaddingStage}"
        RowSpacing="{StaticResource SpacingMd}"
        Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--
          Preview gate (#19, Preview/PreviewView.xaml): the frame drawn by the export's renderer, as large as fits at the
          video's shape, in a 6 px gate; the Layer shows around it.
        -->
        <Grid x:Name="PreviewRegion" Grid.Row="0">
          <preview:PreviewView xmlns:preview="using:TenLapse.Preview" x:Name="PreviewSurface" />
        </Grid>
        <!-- Transport (#19, Preview/TransportBar.xaml): the 36 px play button, the scrubber, the frame counter and the time code. -->
        <Grid
          x:Name="TransportRegion"
          Grid.Row="1"
          Height="{StaticResource PlayButtonSize}">
          <preview:TransportBar xmlns:preview="using:TenLapse.Preview" x:Name="Transport" />
        </Grid>
        <!--
          Filmstrip (#20, Filmstrip/FilmstripView.xaml): every frame as a 3:2 thumbnail in a row that scrolls, and the
          caption row under it. It sizes itself: the thumbnail height (the slider) plus the rings' inset and the caption.
        -->
        <Grid x:Name="FilmstripRegion" Grid.Row="2">
          <filmstrip:FilmstripView xmlns:filmstrip="using:TenLapse.Filmstrip" x:Name="Filmstrip" />
        </Grid>
      </Grid>

      <!--
        Inspector (#17, #18, #23, Look; #24 swaps in the export panel): 320 px, one divider on its left. The 1 px
        top margin clears the Layer's divider; #36's narrow state must set Margin to 0 along with the rest. The
        sections (Timing #17, Output #23; #18's Frame panel goes between them) stack in InspectorRegion, which
        scrolls when the window is short.
      -->
      <Border
        x:Name="InspectorPane"
        Grid.Row="0"
        Grid.Column="1"
        Width="{StaticResource InspectorWidth}"
        Margin="0,1,0,0"
        BorderBrush="{ThemeResource DividerBrush}"
        BorderThickness="1,0,0,0"
        Visibility="Collapsed">
        <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="InspectorRegion" Padding="20,0,20,20">
            <shell:TimingPanel x:Name="TimingSection" />
            <shell:OutputPanel x:Name="OutputSection" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Settings (#26): the whole body, over the Empty and Editing regions, under the InfoBars. -->
      <shell:SettingsView
        x:Name="SettingsPage"
        Grid.RowSpan="2"
        Grid.ColumnSpan="2"
        Visibility="Collapsed" />

      <!--
        InfoBars float over the top of the stage (DESIGN.md, Cards and InfoBars): 32 px down, at most 560 px wide,
        with the Flyout shadow. InfoBarPresenter fills, shows and animates it; FlyoutShadow casts the shadow from
        the rectangle behind the bar, which always has its size.
      -->
      <Grid
        x:Name="InfoBarLayer"
        Grid.Row="0"
        Grid.Column="0"
        MaxWidth="{StaticResource InfoBarMaxWidth}"
        Margin="{StaticResource InfoBarHostMargin}"
        VerticalAlignment="Top"
        Visibility="Collapsed">
        <Rectangle
          x:Name="InfoBarShadowCaster"
          Fill="{ThemeResource CardBrush}"
          RadiusX="6"
          RadiusY="6" />
        <InfoBar
          x:Name="ShellInfoBar"
          IsClosable="True"
          IsOpen="False"
          Style="{StaticResource InfoBarStyle}">
          <!--
            The detail list (#13's skipped photos): under a divider, in line with the message, scrolling past
            InfoBarDetailsMaxHeight. InfoBarPresenter fills it and its toggle opens it; collapsed by default.
          -->
          <Border
            x:Name="InfoBarDetails"
            BorderBrush="{ThemeResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <ScrollViewer MaxHeight="{StaticResource InfoBarDetailsMaxHeight}" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="InfoBarDetailList" Margin="{StaticResource InfoBarDetailsMargin}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="{StaticResource InfoBarDetailsSpacing}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="services:InfoBarDetail">
                    <Grid ColumnSpacing="{StaticResource SpacingMd}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource CaptionTabularTextStyle}" Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Style="{StaticResource CaptionSecondaryTextStyle}" Text="{x:Bind Note}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </InfoBar>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
