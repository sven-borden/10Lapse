<?xml version="1.0" encoding="utf-8"?>
<!--
  The film gate (#24; DESIGN.md, Export panel; motion spec, Gate): the export's frames as 48 x 32 thumbnails with 3 px
  corners and 3 px gaps, sliding linearly past a 54 x 40 frame of 2 px Deep Amber Indicator in the middle as they are
  encoded. Frames already written show at full strength, the ones to come at 30 %. The edges fade into the Layer (the
  canvas's mask, 16 % each side): two Layer gradients over the strip, colored in code from the LayerColor token. With
  animations off the strip stands still and only its pictures change. FilmGate.xaml.cs places the slots.
-->
<UserControl
  x:Class="TenLapse.Shell.FilmGate"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Height="40">

  <Grid x:Name="Root">
    <Canvas x:Name="Strip" />

    <Rectangle x:Name="LeftFade" HorizontalAlignment="Left">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop x:Name="LeftSolid" Offset="0" />
          <GradientStop x:Name="LeftClear" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle x:Name="RightFade" HorizontalAlignment="Right">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop x:Name="RightClear" Offset="0" />
          <GradientStop x:Name="RightSolid" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- The gate: the frame being encoded sits inside it. -->
    <Border
      Width="54"
      Height="40"
      HorizontalAlignment="Center"
      BorderBrush="{ThemeResource DeepAmberIndicatorBrush}"
      BorderThickness="2"
      CornerRadius="5" />
  </Grid>
</UserControl>
