<?xml version="1.0" encoding="utf-8"?>
<!--
  The Settings page (#26 builds the frame and the diagnostics card). A full page over the body, not a dialog
  (DESIGN.md, Navigation): the Layer surface under one divider, a centered column at most 760 px wide, the Title
  "Settings", then sections of settings cards (prototype docs/design/canvas/Main.dc.html, start "settings").
  The command bar shows Back while it is open (ShellView's Settings state).

  Adding a card (#21 defaults and reset, #31 rate and feedback, the about card with the version): a section heading
  with SettingsSectionHeadingStyle (SettingsLaterSectionHeadingStyle after the first) and a Grid with
  SettingsCardStyle: a 20 px icon in Ink Secondary, the title (Body) with its caption (Caption Secondary), the
  control on the right. Unbuilt settings are absent, not disabled.
-->
<UserControl
  x:Class="TenLapse.Shell.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:presentation="using:TenLapse.Presentation"
  xmlns:rating="using:TenLapse.Presentation.Rating"
  xmlns:shell="using:TenLapse.Shell">

  <UserControl.Resources>
    <!-- Settings card (DESIGN.md, Cards and InfoBars): Card fill, Divider border, 6 px corners, 12 x 16 padding, 68 px tall at least. -->
    <Style x:Key="SettingsCardStyle" TargetType="Grid">
      <Setter Property="MinHeight" Value="{StaticResource SettingsCardMinHeight}" />
      <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
      <Setter Property="ColumnSpacing" Value="{StaticResource SpacingLg}" />
      <Setter Property="Background" Value="{ThemeResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    </Style>
    <Style
      x:Key="SettingsSectionHeadingStyle"
      BasedOn="{StaticResource BodyStrongTextStyle}"
      TargetType="TextBlock" />
    <Style
      x:Key="SettingsLaterSectionHeadingStyle"
      BasedOn="{StaticResource BodyStrongTextStyle}"
      TargetType="TextBlock">
      <Setter Property="Margin" Value="{StaticResource SettingsSectionMargin}" />
    </Style>
    <Style x:Key="SettingsCardIconStyle" TargetType="FontIcon">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{ThemeResource InkSecondaryBrush}" />
    </Style>
  </UserControl.Resources>

  <Border
    Background="{ThemeResource LayerBrush}"
    BorderBrush="{ThemeResource DividerBrush}"
    BorderThickness="0,1,0,0">
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
      <!-- The page is the window's main landmark while it shows (#38). -->
      <shell:Region
        Padding="{StaticResource PaddingSettingsPage}"
        AutomationProperties.LandmarkType="Main"
        AutomationProperties.Name="{x:Bind presentation:ProjectText.SettingsTitle}">
        <StackPanel MaxWidth="{StaticResource SettingsPageMaxWidth}" Spacing="{StaticResource SettingsCardSpacing}">
          <TextBlock
            Margin="{StaticResource SettingsTitleMargin}"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextStyle}"
            Text="{x:Bind presentation:ProjectText.SettingsTitle}" />

          <TextBlock
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource SettingsSectionHeadingStyle}"
            Text="{x:Bind presentation:ProjectText.SettingsDefaultsSection}" />
          <Grid Style="{StaticResource SettingsCardStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Segoe Fluent Icons "Undo". -->
            <FontIcon Glyph="&#xE7A7;" Style="{StaticResource SettingsCardIconStyle}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock
                Style="{StaticResource BodyTextStyle}"
                Text="{x:Bind presentation:ProjectText.ResetCardTitle}" />
              <TextBlock
                Style="{StaticResource CaptionSecondaryTextStyle}"
                Text="{x:Bind presentation:ProjectText.ResetCardCaption}"
                TextWrapping="Wrap" />
            </StackPanel>
            <Button
              Grid.Column="2"
              Height="{StaticResource ControlHeight}"
              Padding="{StaticResource PaddingButtonStandard}"
              VerticalAlignment="Center"
              Command="{x:Bind ViewModel.ResetToDefaultsCommand}"
              Content="{x:Bind presentation:ProjectText.ResetButton}" />
          </Grid>

          <TextBlock
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource SettingsLaterSectionHeadingStyle}"
            Text="{x:Bind presentation:ProjectText.SettingsAboutSection}" />
          <Grid Style="{StaticResource SettingsCardStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Segoe Fluent Icons "Diagnostic". -->
            <FontIcon Glyph="&#xE9D9;" Style="{StaticResource SettingsCardIconStyle}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock
                Style="{StaticResource BodyTextStyle}"
                Text="{x:Bind presentation:ProjectText.DiagnosticsCardTitle}" />
              <TextBlock
                Style="{StaticResource CaptionSecondaryTextStyle}"
                Text="{x:Bind presentation:ProjectText.DiagnosticsCardCaption}"
                TextWrapping="Wrap" />
            </StackPanel>
            <Button
              Grid.Column="2"
              Height="{StaticResource ControlHeight}"
              Padding="{StaticResource PaddingButtonStandard}"
              VerticalAlignment="Center"
              Command="{x:Bind ViewModel.CopyDiagnosticsCommand}"
              Content="{x:Bind presentation:ProjectText.CopyDiagnostics}" />
          </Grid>

          <!-- #31: both buttons hand a link to another app (the Store, the browser); 10Lapse itself makes no request. -->
          <Grid Style="{StaticResource SettingsCardStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Segoe Fluent Icons "FavoriteStar". -->
            <FontIcon Glyph="&#xE734;" Style="{StaticResource SettingsCardIconStyle}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock
                Style="{StaticResource BodyTextStyle}"
                Text="{x:Bind rating:RatingText.CardTitle}" />
              <TextBlock
                Style="{StaticResource CaptionSecondaryTextStyle}"
                Text="{x:Bind rating:RatingText.CardCaption}"
                TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
              Grid.Column="2"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="{StaticResource SpacingSm}">
              <Button
                Height="{StaticResource ControlHeight}"
                Padding="{StaticResource PaddingButtonStandard}"
                AutomationProperties.Name="{x:Bind rating:RatingText.FeedbackButton}"
                Command="{x:Bind ViewModel.SendFeedbackCommand}"
                Content="{x:Bind rating:RatingText.FeedbackButton}"
                ToolTipService.ToolTip="{x:Bind rating:RatingText.FeedbackTip}" />
              <Button
                Height="{StaticResource ControlHeight}"
                Padding="{StaticResource PaddingButtonStandard}"
                AutomationProperties.Name="{x:Bind rating:RatingText.RateButton}"
                Command="{x:Bind ViewModel.RateCommand}"
                Content="{x:Bind rating:RatingText.RateButton}"
                ToolTipService.ToolTip="{x:Bind rating:RatingText.RateTip}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </shell:Region>
    </ScrollViewer>
  </Border>
</UserControl>
