<?xml version="1.0" encoding="utf-8"?>
<Application
  x:Class="TenLapse.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Tokens (docs: DESIGN.md). Order matters: ControlOverrides and Typography read the color and motion tokens. -->
        <ResourceDictionary Source="ms-appx:///Themes/Colors.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Motion.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/ControlOverrides.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Layout.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
