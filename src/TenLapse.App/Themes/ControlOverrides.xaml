      <SolidColorBrush x:Key="ProgressBarForeground" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="ProgressBarBackground" Color="{ThemeResource TrackColor}" />
      <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <!-- Slider (the scrubber): the filled part and the thumb dot are the indicator, with hover and press tints. -->
      <SolidColorBrush x:Key="SliderTrackFill" Color="{ThemeResource TrackColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{ThemeResource DeepAmberIndicatorColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="{ThemeResource DeepAmberIndicatorColor}" Opacity="0.4" />
