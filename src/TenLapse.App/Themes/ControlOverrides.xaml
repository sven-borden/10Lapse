      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <!-- Check box and radio button: checked and indeterminate are the indicator. -->
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminateDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{ThemeResource OnIndicatorColor}" />
      <!-- Toggle button, checked: a recessed Segment Track fill with an Ink outline (a setting, never amber); HighContrast uses Highlight with HighlightText. -->
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <!-- Selection indicators: the pip beside a selected list item, navigation or pivot entry. -->
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="PivotHeaderItemSelectedPipeFill" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <!-- Focus: the Windows double ring, Ink over the ground (DESIGN.md Elevation, Focus). Text boxes underline in Ink, not accent. -->
      <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource InkColor}" />
      <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{ThemeResource LayerColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource InkColor}" />
      <!-- Text actions: Ember Link. HighContrast moves from Hotlight to Highlight on hover and press. -->
      <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource EmberLinkColor}" />
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
      <!-- InfoBar (DESIGN.md, Cards and InfoBars): the status fill (Neutral is Card), the icon in the status color, Ink text, a Control Stroke border. The tokens map to system colors in HighContrast. -->
      <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{ThemeResource CriticalFillColor}" />
      <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{ThemeResource CautionFillColor}" />
      <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{ThemeResource SuccessFillColor}" />
      <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{ThemeResource CardColor}" />
      <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="{ThemeResource CriticalColor}" />
      <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="{ThemeResource CautionColor}" />
      <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="{ThemeResource SuccessColor}" />
      <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="{ThemeResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="InfoBarErrorSeverityIconForeground" Color="{ThemeResource LayerColor}" />
      <SolidColorBrush x:Key="InfoBarWarningSeverityIconForeground" Color="{ThemeResource LayerColor}" />
      <SolidColorBrush x:Key="InfoBarSuccessSeverityIconForeground" Color="{ThemeResource LayerColor}" />
      <SolidColorBrush x:Key="InfoBarInformationalSeverityIconForeground" Color="{ThemeResource LayerColor}" />
      <SolidColorBrush x:Key="InfoBarTitleForeground" Color="{ThemeResource InkColor}" />
      <SolidColorBrush x:Key="InfoBarMessageForeground" Color="{ThemeResource InkColor}" />
      <SolidColorBrush x:Key="InfoBarBorderBrush" Color="{ThemeResource ControlStrokeColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!--
    InfoBarStyle: the InfoBar laid out as the prototype's (docs/design/canvas/Main.dc.html, InfoBar): one row
    in PaddingInfoBar (10 / 8 / 10 / 14) with 12 px gaps: the severity icon, the message, the action or list
    toggle (28 px, PaddingInfoBarButton) and the 28 px Dismiss button; the InfoBar's Content (the detail
    list) spans the width under it. The row is as tall as its buttons, so every InfoBar is 50 px with or
    without an action. The stock template's StaticResource paddings cannot be overridden from the app, hence a
    template. It keeps the stock part and state names (CloseButton, SeverityLevels, IconStates and the rest),
    which the control drives; it has no Title, which no InfoBar here uses. Layout and Typography keys are
    ThemeResource because those dictionaries merge after this one.
  -->
  <Style x:Key="InfoBarDismissButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Width" Value="{ThemeResource InfoBarButtonHeight}" />
    <Setter Property="Height" Value="{ThemeResource InfoBarButtonHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{ThemeResource RadiusControl}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="InfoBarStyle" TargetType="InfoBar">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource InfoBarBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{ThemeResource RadiusCard}" />
    <Setter Property="CloseButtonStyle" Value="{StaticResource InfoBarDismissButtonStyle}" />
    <Setter Property="AutomationProperties.LandmarkType" Value="Custom" />
    <Setter Property="AutomationProperties.IsDialog" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="InfoBar">
          <Border
            x:Name="ContentRoot"
            VerticalAlignment="Top"
            Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="SeverityLevels">
                <VisualState x:Name="Informational" />
                <VisualState x:Name="Error">
                  <VisualState.Setters>
                    <Setter Target="ContentRoot.Background" Value="{ThemeResource InfoBarErrorSeverityBackgroundBrush}" />
                    <Setter Target="IconBackground.Foreground" Value="{ThemeResource InfoBarErrorSeverityIconBackground}" />
                    <Setter Target="StandardIcon.Text" Value="&#xF13D;" />
                    <Setter Target="StandardIcon.Foreground" Value="{ThemeResource InfoBarErrorSeverityIconForeground}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warning">
                  <VisualState.Setters>
                    <Setter Target="ContentRoot.Background" Value="{ThemeResource InfoBarWarningSeverityBackgroundBrush}" />
                    <Setter Target="IconBackground.Foreground" Value="{ThemeResource InfoBarWarningSeverityIconBackground}" />
                    <Setter Target="StandardIcon.Text" Value="&#xF13C;" />
                    <Setter Target="StandardIcon.Foreground" Value="{ThemeResource InfoBarWarningSeverityIconForeground}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Success">
                  <VisualState.Setters>
                    <Setter Target="ContentRoot.Background" Value="{ThemeResource InfoBarSuccessSeverityBackgroundBrush}" />
                    <Setter Target="IconBackground.Foreground" Value="{ThemeResource InfoBarSuccessSeverityIconBackground}" />
                    <Setter Target="StandardIcon.Text" Value="&#xF13E;" />
                    <Setter Target="StandardIcon.Foreground" Value="{ThemeResource InfoBarSuccessSeverityIconForeground}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="IconStates">
                <VisualState x:Name="StandardIconVisible">
                  <VisualState.Setters>
                    <Setter Target="StandardIconArea.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="UserIconVisible" />
                <VisualState x:Name="NoIconVisible" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="CloseButtonStates">
                <VisualState x:Name="CloseButtonVisible" />
                <VisualState x:Name="CloseButtonCollapsed">
                  <VisualState.Setters>
                    <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="InfoBarVisibility">
                <VisualState x:Name="InfoBarVisible" />
                <VisualState x:Name="InfoBarCollapsed">
                  <VisualState.Setters>
                    <Setter Target="ContentRoot.Visibility" Value="Collapsed" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Padding="{ThemeResource PaddingInfoBar}" ColumnSpacing="{ThemeResource SpacingMd}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="StandardIconArea" VerticalAlignment="Center" Visibility="Collapsed">
                  <TextBlock
                    x:Name="IconBackground"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Foreground="{ThemeResource InfoBarInformationalSeverityIconBackground}"
                    Text="&#xF136;" />
                  <TextBlock
                    x:Name="StandardIcon"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Foreground="{ThemeResource InfoBarInformationalSeverityIconForeground}"
                    Text="&#xF13F;" />
                </Grid>
                <TextBlock
                  x:Name="Message"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource InfoBarMessageForeground}"
                  Style="{ThemeResource BodyTextStyle}"
                  Text="{TemplateBinding Message}"
                  TextWrapping="WrapWholeWords" />
                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Content="{TemplateBinding ActionButton}">
                  <ContentPresenter.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                      <Setter Property="Height" Value="{ThemeResource InfoBarButtonHeight}" />
                      <Setter Property="Padding" Value="{ThemeResource PaddingInfoBarButton}" />
                      <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <Button
                  x:Name="CloseButton"
                  Grid.Column="3"
                  Command="{TemplateBinding CloseButtonCommand}"
                  CommandParameter="{TemplateBinding CloseButtonCommandParameter}"
                  Style="{TemplateBinding CloseButtonStyle}">
                  <!-- A subtle button: transparent with the Ink wash on hover, the glyph in Ink Secondary. -->
                  <Button.Resources>
                    <ResourceDictionary>
                      <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                          <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillHoverColor}" />
                          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtleFillPressedColor}" />
                          <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                          <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource InkSecondaryColor}" />
                          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource InkColor}" />
                          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource InkSecondaryColor}" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                          <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillHoverColor}" />
                          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtleFillPressedColor}" />
                          <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                          <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource InkSecondaryColor}" />
                          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource InkColor}" />
                          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource InkSecondaryColor}" />
                        </ResourceDictionary>
                      </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                  </Button.Resources>
                  <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
              </Grid>
              <ContentPresenter
                x:Name="ContentArea"
                Grid.Row="1"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ExportButtonStyle: the one amber button (DESIGN.md, Buttons: the accent button is the Export fill). It is
    Fluent's AccentButtonStyle with its own template, because WinUI 3 styles have no Resources and the global
    AccentButton* keys must stay untouched. The state brushes live in the template root's Resources, so the
    lookups below never leave this style. Rest comes from the Style setters (Fluent's template reads them
    through TemplateBinding; a ThemeResource inside XamlControlsResources would not see app overrides).
    Disabled is neutral on purpose: a ControlFill fill, ControlStroke border and Ink Secondary text, not a
    washed-out amber. HighContrast inverts on hover and press and uses ButtonFace and GrayText when disabled.
  -->
  <Style x:Key="ExportButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource GoldenHourAmberBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NightInkOnAmberBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource GoldenHourAmberStrokeBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root">
            <Grid.Resources>
              <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                  <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ExportBackgroundPointerOver" Color="{ThemeResource GoldenHourAmberHoverColor}" />
                    <SolidColorBrush x:Key="ExportBackgroundPressed" Color="{ThemeResource GoldenHourAmberPressedColor}" />
                    <SolidColorBrush x:Key="ExportBackgroundDisabled" Color="{ThemeResource ControlFillColor}" />
                    <SolidColorBrush x:Key="ExportForegroundPointerOver" Color="{ThemeResource NightInkOnAmberColor}" />
                    <SolidColorBrush x:Key="ExportForegroundPressed" Color="{ThemeResource NightInkOnAmberPressedColor}" />
                    <SolidColorBrush x:Key="ExportForegroundDisabled" Color="{ThemeResource InkSecondaryColor}" Opacity="0.6" />
                    <SolidColorBrush x:Key="ExportBorderPointerOver" Color="{ThemeResource GoldenHourAmberStrokeColor}" />
                    <SolidColorBrush x:Key="ExportBorderPressed" Color="{ThemeResource GoldenHourAmberStrokeColor}" />
                    <SolidColorBrush x:Key="ExportBorderDisabled" Color="{ThemeResource ControlStrokeColor}" />
                  </ResourceDictionary>
                  <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ExportBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ExportBackgroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ExportBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="ExportForegroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ExportForegroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ExportForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ExportBorderPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ExportBorderPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ExportBorderDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                  </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
              </ResourceDictionary>
            </Grid.Resources>
            <ContentPresenter
              x:Name="ContentPresenter"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              AutomationProperties.AccessibilityView="Raw"
              Background="{TemplateBinding Background}"
              BackgroundSizing="{TemplateBinding BackgroundSizing}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              ContentTransitions="{TemplateBinding ContentTransitions}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Foreground="{TemplateBinding Foreground}">
              <ContentPresenter.BackgroundTransition>
                <BrushTransition Duration="0:0:0.083" />
              </ContentPresenter.BackgroundTransition>
            </ContentPresenter>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource ExportBackgroundPointerOver}" />
                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ExportBorderPointerOver}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ExportForegroundPointerOver}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource ExportBackgroundPressed}" />
                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ExportBorderPressed}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ExportForegroundPressed}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource ExportBackgroundDisabled}" />
                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ExportBorderDisabled}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ExportForegroundDisabled}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    AccentActionButtonStyle: the one accent button of a screen that has no Export button (DESIGN.md, Colors: the
    accent fill is for Export video, Choose folder on first launch and Play on the finished state). The Export
    button's look under a name that says what it is for; the amber stays inside ExportButtonStyle.
  -->
  <Style x:Key="AccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ExportButtonStyle}">
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource PaddingButtonAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</ResourceDictionary>
