      <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource DeepAmberIndicatorColor}" />
