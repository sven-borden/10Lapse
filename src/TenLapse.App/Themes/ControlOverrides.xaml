      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminateDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{ThemeResource OnIndicatorColor}" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{ThemeResource OnIndicatorColor}" />
      <!-- Toggle button, checked: a recessed Segment Track fill with an Ink outline (a setting, never amber); HighContrast uses Highlight with HighlightText. -->
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
      <!-- Selection indicators: the pip beside a selected list item, navigation or pivot entry. -->
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="PivotHeaderItemSelectedPipeFill" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <!-- Focus: the Windows double ring, Ink over the ground (DESIGN.md Elevation, Focus). Text boxes underline in Ink, not accent. -->
      <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource InkColor}" />
      <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{ThemeResource LayerColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource InkColor}" />
      <!-- Text actions: Ember Link. HighContrast moves from Hotlight to Highlight on hover and press. -->
      <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource EmberLinkColor}" />
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!--
    ExportButtonStyle: the one amber button (DESIGN.md, Buttons: the accent button is the Export fill). It is
    Fluent's AccentButtonStyle with its own template, because WinUI 3 styles have no Resources and the global
    AccentButton* keys must stay untouched. The state brushes live in the template root's Resources, so the
    lookups below never leave this style. Rest comes from the Style setters (Fluent's template reads them
    through TemplateBinding; a ThemeResource inside XamlControlsResources would not see app overrides).
    Disabled is neutral on purpose: a ControlFill fill, ControlStroke border and Ink Secondary text, not a
    washed-out amber. HighContrast inverts on hover and press and uses ButtonFace and GrayText when disabled.
  -->
  <Style x:Key="ExportButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource GoldenHourAmberBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NightInkOnAmberBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource GoldenHourAmberStrokeBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root">
            <Grid.Resources>
              <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                  <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ExportBackgroundPointerOver" Color="{ThemeResource GoldenHourAmberHoverColor}" />
                    <SolidColorBrush x:Key="ExportBackgroundPressed" Color="{ThemeResource GoldenHourAmberPressedColor}" />
                    <SolidColorBrush x:Key="ExportBackgroundDisabled" Color="{ThemeResource ControlFillColor}" />
                    <SolidColorBrush x:Key="ExportForegroundPointerOver" Color="{ThemeResource NightInkOnAmberColor}" />
                    <SolidColorBrush x:Key="ExportForegroundPressed" Color="{ThemeResource NightInkOnAmberPressedColor}" />
                    <SolidColorBrush x:Key="ExportForegroundDisabled" Color="{ThemeResource InkSecondaryColor}" Opacity="0.6" />
                    <SolidColorBrush x:Key="ExportBorderPointerOver" Color="{ThemeResource GoldenHourAmberStrokeColor}" />
                    <SolidColorBrush x:Key="ExportBorderPressed" Color="{ThemeResource GoldenHourAmberStrokeColor}" />
                    <SolidColorBrush x:Key="ExportBorderDisabled" Color="{ThemeResource ControlStrokeColor}" />
                  </ResourceDictionary>
                  <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ExportBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ExportBackgroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ExportBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="ExportForegroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ExportForegroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ExportForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ExportBorderPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ExportBorderPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ExportBorderDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                  </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
              </ResourceDictionary>
            </Grid.Resources>
            <ContentPresenter
              x:Name="ContentPresenter"
              Padding="{TemplateBinding Padding}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              AutomationProperties.AccessibilityView="Raw"
              Background="{TemplateBinding Background}"
              BackgroundSizing="{TemplateBinding BackgroundSizing}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              ContentTransitions="{TemplateBinding ContentTransitions}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Foreground="{TemplateBinding Foreground}">
              <ContentPresenter.BackgroundTransition>
                <BrushTransition Duration="0:0:0.083" />
              </ContentPresenter.BackgroundTransition>
            </ContentPresenter>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource ExportBackgroundPointerOver}" />
                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ExportBorderPointerOver}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ExportForegroundPointerOver}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource ExportBackgroundPressed}" />
                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ExportBorderPressed}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ExportForegroundPressed}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource ExportBackgroundDisabled}" />
                    <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ExportBorderDisabled}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ExportForegroundDisabled}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
