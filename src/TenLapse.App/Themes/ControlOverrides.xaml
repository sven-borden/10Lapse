<?xml version="1.0" encoding="utf-8"?>
<!--
  Fluent control overrides so stock controls follow the brand rules without per-page work. Merged after
  XamlControlsResources and Colors.xaml.

  Decision: each control's own theme resource keys are overridden, not SystemAccentColor. The accent
  split (amber fill for Export, indicator for state, neutral for everything else) cannot be expressed
  by one global accent, and XamlControlsResources resolves its internal aliases (ToggleSwitchFillOn to
  AccentFillColorDefaultBrush) inside its own dictionary, so only the specific keys are reliable.
  Everything not listed keeps Fluent's neutral defaults.

  Fluent's AccentButtonStyle and the global AccentButton* keys are left alone on purpose: standard accent
  buttons (a ContentDialog's primary button, say) keep the system accent color. The amber Export button is
  ExportButtonStyle at the bottom, which carries its own brushes. The only amber in this file is there.

  The same keys appear in Light, Dark and HighContrast. In Light and Dark the values are token brushes from
  Colors.xaml and Disabled is 40% opacity. In HighContrast every value resolves to a Windows system color
  (no amber, no opacity): tracks are WindowText so they show on Window, Disabled is GrayText, hover and press
  move to Hotlight or invert, and a checked toggle button is Highlight with HighlightText.
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Progress: the indicator on the Track ground. HighContrast tracks use WindowText so they show on Window. -->
      <SolidColorBrush x:Key="ProgressBarForeground" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="ProgressBarBackground" Color="{ThemeResource TrackColor}" />
      <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <!-- Slider (the scrubber): the filled part and the thumb dot are the indicator, with hover and press tints. -->
      <SolidColorBrush x:Key="SliderTrackFill" Color="{ThemeResource TrackColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{ThemeResource DeepAmberIndicatorColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="{ThemeResource DeepAmberIndicatorColor}" Opacity="0.4" />
      <!-- Toggle switch: on is the indicator with an OnIndicator knob; off is an Ink Secondary outline and knob (WindowText in HighContrast). -->
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{ThemeResource DeepAmberIndicatorColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{ThemeResource DeepAmberIndicatorHoverColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{ThemeResource DeepAmberIndicatorPressedColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="{ThemeResource DeepAmberIndicatorColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{ThemeResource OnIndicatorColor}" />
