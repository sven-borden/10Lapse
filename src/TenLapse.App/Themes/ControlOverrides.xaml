<?xml version="1.0" encoding="utf-8"?>
<!--
  Fluent control overrides so stock controls follow the brand rules without per-page work. Merged after
  XamlControlsResources and Colors.xaml.

  Decision: each control's own theme resource keys are overridden, not SystemAccentColor. The accent
  split (amber fill for Export, indicator for state, neutral for everything else) cannot be expressed
  by one global accent, and XamlControlsResources resolves its internal aliases (ToggleSwitchFillOn to
  AccentFillColorDefaultBrush) inside its own dictionary, so only the specific keys are reliable.
  Everything not listed keeps Fluent's neutral defaults.

  The same keys appear in Light, Dark and HighContrast. The values are token brushes from Colors.xaml,
  which in HighContrast resolve to system colors (Highlight and HighlightText, no amber).
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Accent button: the Export fill. Amber with night-ink text, a faint warm border; disabled is 40% opacity. -->
      <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource GoldenHourAmberColor}" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource GoldenHourAmberHoverColor}" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource GoldenHourAmberPressedColor}" />
      <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{ThemeResource GoldenHourAmberColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource NightInkOnAmberColor}" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource NightInkOnAmberColor}" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource NightInkOnAmberPressedColor}" />
      <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{ThemeResource NightInkOnAmberColor}" Opacity="0.4" />
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{ThemeResource GoldenHourAmberStrokeColor}" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{ThemeResource GoldenHourAmberStrokeColor}" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{ThemeResource GoldenHourAmberStrokeColor}" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="{ThemeResource GoldenHourAmberStrokeColor}" Opacity="0.4" />
      <!-- Progress: the indicator on the Track ground. -->
      <SolidColorBrush x:Key="ProgressBarForeground" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <SolidColorBrush x:Key="ProgressBarBackground" Color="{ThemeResource TrackColor}" />
      <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{ThemeResource DeepAmberIndicatorColor}" />
      <!-- Slider (the scrubber): the filled part and the thumb dot are the indicator. -->
