<?xml version="1.0" encoding="utf-8"?>
<!--
  Type ramp from DESIGN.md, Typography. One family, the Windows 11 system face: Segoe UI Variable Text up
  to 14 px, Segoe UI Variable Display above. Sizes, weights and line heights are the spec's.

  Style keys: <Step>TextStyle for each step, <Step>TabularTextStyle for readouts and counters (tabular
  figures, the Tabular Rule), and CaptionSecondaryTextStyle for Ink Secondary captions. Caption, Subtitle
  and Title large are tabular in the spec, so their plain styles already are. The names differ from
  Fluent's *TextBlockStyle on purpose, so both can be used side by side.
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="TextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

  <!-- Caption (400, 12/16, tabular): labels, file details, time codes, hints -->
  <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
  <Style x:Key="CaptionTabularTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <!-- Labels and detail in Ink Secondary; there is no lighter grey for text. -->
  <Style x:Key="CaptionSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource InkSecondaryBrush}" />
  </Style>

  <!-- Body (400, 14/20): running text, buttons, menu items -->
  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
  <Style x:Key="BodyTabularTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <!-- Body strong (600, 14/20): section headers, the selected segment, accent buttons -->
  <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="BodyStrongTabularTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <!-- Subtitle (600, 20/28, tabular): the speed readout, panel titles -->
  <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
  <Style x:Key="SubtitleTabularTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextStyle}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <!-- Title (600, 28/36): screen titles on first launch and settings -->
  <Style x:Key="TitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
  <Style x:Key="TitleTabularTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextStyle}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <!-- Title large (600, 40/52, tabular): the export percent -->
  <Style x:Key="TitleLargeTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="52" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
  <Style x:Key="TitleLargeTabularTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextStyle}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <!-- Display (600, 68/92, tracked -2%): the wordmark on splash and Store art only. CharacterSpacing is 1/1000 em. -->
  <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontSize" Value="68" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="92" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="CharacterSpacing" Value="-20" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
  </Style>
  <Style x:Key="DisplayTabularTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextStyle}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

</ResourceDictionary>
