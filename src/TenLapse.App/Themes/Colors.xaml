      <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource InkColor}" />
      <SolidColorBrush x:Key="InkSecondaryBrush" Color="{ThemeResource InkSecondaryColor}" />
      <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
