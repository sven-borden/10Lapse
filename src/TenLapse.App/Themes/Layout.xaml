<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout tokens from DESIGN.md (frontmatter spacing and rounded, sections 1, 4 and 5).

  Spacing: Spacing<Step> as x:Double on the 4 px grid, Thickness<Step> as uniform Thickness.
  Radius: Radius<Name> as CornerRadius. Sizes: ControlHeight and the fixed shell dimensions.
  Elevation: only flyouts cast a shadow (The Float Only Rule). WinUI has no CSS box-shadow, so the
  spec's values are kept as numbers (blur, offset in px) here and as colors (ShadowFlyoutColor and friends
  in Colors.xaml), ready for a Composition DropShadow (BlurRadius, Offset, Color). There is no ThemeShadow
  token on purpose: ThemeShadow.Receivers.Add threw E_INVALIDARG for every receiver tried in the Debug
  gallery on Windows App SDK 2.5.1, and ThemeShadow ignores the spec's numbers anyway.
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Spacing scale: 4 px grid, xxs to 4xl -->
  <x:Double x:Key="SpacingXxs">2</x:Double>
  <x:Double x:Key="SpacingXs">4</x:Double>
  <x:Double x:Key="SpacingSm">8</x:Double>
  <x:Double x:Key="SpacingMd">12</x:Double>
  <x:Double x:Key="SpacingLg">16</x:Double>
  <x:Double x:Key="SpacingXl">20</x:Double>
  <x:Double x:Key="Spacing2xl">28</x:Double>
  <x:Double x:Key="Spacing3xl">40</x:Double>
  <x:Double x:Key="Spacing4xl">64</x:Double>

  <Thickness x:Key="ThicknessXxs">2</Thickness>
  <Thickness x:Key="ThicknessXs">4</Thickness>
  <Thickness x:Key="ThicknessSm">8</Thickness>
  <Thickness x:Key="ThicknessMd">12</Thickness>
  <Thickness x:Key="ThicknessLg">16</Thickness>
  <Thickness x:Key="ThicknessXl">20</Thickness>
  <Thickness x:Key="Thickness2xl">28</Thickness>
  <Thickness x:Key="Thickness3xl">40</Thickness>
  <Thickness x:Key="Thickness4xl">64</Thickness>

  <!-- Component padding (left, top, right, bottom) -->
  <Thickness x:Key="PaddingStage">20</Thickness>
  <Thickness x:Key="PaddingInspector">20</Thickness>
  <Thickness x:Key="PaddingCard">16,12,16,12</Thickness>
  <Thickness x:Key="PaddingButtonAccent">14,0,14,0</Thickness>
  <Thickness x:Key="PaddingButtonStandard">12,0,12,0</Thickness>
  <Thickness x:Key="PaddingButtonSubtle">10,0,10,0</Thickness>
  <Thickness x:Key="PaddingSelect">8,0,8,0</Thickness>
  <Thickness x:Key="PaddingSegmentedTrack">2</Thickness>
  <Thickness x:Key="PaddingInfoBar">14,10,8,10</Thickness>

  <!-- Radius tokens -->
  <CornerRadius x:Key="RadiusThumb">3</CornerRadius>
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusSegmentedTrack">5</CornerRadius>
  <CornerRadius x:Key="RadiusCard">6</CornerRadius>
  <CornerRadius x:Key="RadiusOverlay">8</CornerRadius>
  <CornerRadius x:Key="RadiusRound">999</CornerRadius>

  <!-- Sizes -->
  <x:Double x:Key="ControlHeight">32</x:Double>
  <x:Double x:Key="PlayButtonSize">36</x:Double>
  <x:Double x:Key="TitleBarHeight">40</x:Double>
  <x:Double x:Key="CommandBarHeight">48</x:Double>
  <x:Double x:Key="SettingsCardMinHeight">68</x:Double>
  <x:Double x:Key="ToggleSwitchTrackWidth">40</x:Double>
  <x:Double x:Key="ToggleSwitchTrackHeight">20</x:Double>
  <x:Double x:Key="InspectorWidth">320</x:Double>
  <x:Double x:Key="NarrowPanelHeight">260</x:Double>
  <x:Double x:Key="InspectorDockMinWindowWidth">1000</x:Double>
  <x:Double x:Key="MinWindowWidth">640</x:Double>
  <x:Double x:Key="MinWindowHeight">480</x:Double>
  <!-- The size a new window opens at (the prototype's frame), when the screen's work area has room for it -->
  <x:Double x:Key="DefaultWindowWidth">1280</x:Double>
  <x:Double x:Key="DefaultWindowHeight">800</x:Double>

  <!--
    Shell regions (prototype docs/design/canvas/Main.dc.html): the InfoBar floats 32 px below the top of the
    stage (20 padding + 12), at most 560 wide and at least 40 px in from each side. The filmstrip holds 3:2
    thumbnails, an 8 px gap and a 16 px caption row: 56 px in the 1280 px window.
  -->
  <x:Double x:Key="InfoBarMaxWidth">560</x:Double>
  <Thickness x:Key="InfoBarHostMargin">40,32,40,0</Thickness>
  <x:Double x:Key="FilmstripMinHeight">56</x:Double>

  <!-- Elevation: flyout (InfoBars over the preview, select menus, the first-launch sample frame): two layers, ambient then key -->
  <x:Double x:Key="ElevationFlyoutBlur">28</x:Double>
  <x:Double x:Key="ElevationFlyoutOffsetY">8</x:Double>
  <x:Double x:Key="ElevationFlyoutKeyBlur">6</x:Double>
  <x:Double x:Key="ElevationFlyoutKeyOffsetY">2</x:Double>

  <!-- Elevation: pill (the selected pill inside a segmented control), with a 1 px ShadowPillRingColor hairline in light -->
  <x:Double x:Key="ElevationPillBlur">2</x:Double>
  <x:Double x:Key="ElevationPillOffsetY">1</x:Double>

  <!-- Elevation: focus is a double ring, 1 px ground then 3 px ink in total (FocusVisualSecondaryBrush, FocusVisualPrimaryBrush) -->
  <x:Double x:Key="FocusRingGapThickness">1</x:Double>
  <x:Double x:Key="FocusRingThickness">2</x:Double>

</ResourceDictionary>
