<?xml version="1.0" encoding="utf-8"?>
<!--
  The Store identity of the 10Lapse listing (product 9NBN2XH6S4D8), identical to
  the 2.1.1 UWP package so 3.0 installs as an update. Name, Publisher,
  PublisherDisplayName and the Application Id must not change. Capabilities:
  runFullTrust and nothing else (CLAUDE.md, invariants). Both DisplayNames stay the
  literal reserved Store name 10Lapse; the description is ms-resource:AppDescription in
  Strings/en-US/Resources.resw (#39), so a translation is a new .resw.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap com desktop">

  <Identity
    Name="62394glaglasven.10Lapse"
    Publisher="CN=A4CDA1AE-2891-435C-B73F-FCA7B39485F4"
    Version="3.1.0.0" />

  <Properties>
    <DisplayName>10Lapse</DisplayName>
    <PublisherDisplayName>glaglasven</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="10Lapse"
        Description="ms-resource:AppDescription"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" />
        <!-- 620 x 300 at every scale. The art is transparent; the colour is Mica Dark (DESIGN.md), so a dark start never flashes white. -->
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1F1E1D" />
      </uap:VisualElements>
      <!--
        The export's notification (#24): the Windows App SDK's AppNotificationManager needs a packaged app to declare its
        notification activator (a COM class served by the app itself). An extension, not a capability: the app still
        declares runFullTrust and nothing else.
      -->
      <!--
        Project files (#52): .10lapse opens in 10Lapse from File Explorer. An extension, not a capability: the app still
        declares runFullTrust and nothing else. Each double click starts a 10Lapse of its own with that project
        (LaunchFile); a running one keeps its project. The type's name is localized in Strings/<lang>/Resources.resw.
      -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="tenlapseproject">
            <uap:DisplayName>ms-resource:ProjectFileTypeName</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/json">.10lapse</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="9e7d1168-7b23-4663-923a-fb9327d7d040" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="TenLapse.App.exe" Arguments="----AppNotificationActivated:" DisplayName="10Lapse notifications">
              <com:Class Id="9e7d1168-7b23-4663-923a-fb9327d7d040" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
