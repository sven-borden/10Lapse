<?xml version="1.0" encoding="utf-8"?>
<!--
  The transport (#19), the 36 px row under the preview (prototype docs/design/canvas/Main.dc.html, Transport; DESIGN.md
  play-button): the round play button, the scrubber, then the frame counter ("0312 / 0742") and the time code
  ("00:10.40 / 00:24.73") in Caption, tabular, Ink Secondary. 12 px between them (SpacingMd; the prototype's 14 is off
  the 4 px grid). The counter and time code carry names Narrator reads ("Frame 312 of 742") that change only while
  paused, so playback does not flood it.
-->
<UserControl
  x:Class="TenLapse.Preview.TransportBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:keyboard="using:TenLapse.Presentation.Keyboard"
  xmlns:local="using:TenLapse.Preview">
  <UserControl.Resources>
    <ResourceDictionary>
      <!-- The play button is a standard button (DESIGN.md, Buttons): Control Fill, Control Stroke, Ink; hover and press step toward Segment Track. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource ControlFillColor}" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SegmentTrackColor}" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SegmentTrackColor}" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource ControlStrokeColor}" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource ControlStrokeColor}" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource ControlStrokeColor}" />
          <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource InkColor}" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource InkColor}" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource InkSecondaryColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource ControlFillColor}" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SegmentTrackColor}" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SegmentTrackColor}" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource ControlStrokeColor}" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource ControlStrokeColor}" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource ControlStrokeColor}" />
          <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource InkColor}" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource InkColor}" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource InkSecondaryColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid ColumnSpacing="{StaticResource SpacingMd}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Play or pause (Space anywhere but in a text box). Its icon is the prototype's 14 px triangle or bars in a 16 px box. -->
    <Button
      x:Name="PlayButton"
      Width="{StaticResource PlayButtonSize}"
      Height="{StaticResource PlayButtonSize}"
      Padding="0"
      VerticalAlignment="Center"
      AutomationProperties.AcceleratorKey="{x:Bind keyboard:KeyText.PlayKeys}"
      AutomationProperties.Name="{x:Bind Player.PlayPauseName, Mode=OneWay, FallbackValue=''}"
      Command="{x:Bind Player.PlayPauseCommand, Mode=OneWay}"
      CornerRadius="{StaticResource RadiusRound}"
      ToolTipService.ToolTip="{x:Bind Player.PlayPauseTip, Mode=OneWay, FallbackValue=''}">
      <Viewbox Width="14" Height="14">
        <Grid Width="16" Height="16">
          <PathIcon
            x:Name="PlayIcon"
            Data="F1 M5,3.2 V12.8 A0.6,0.6 0 0 0 5.9,13.3 L13.3,8.5 A0.6,0.6 0 0 0 13.3,7.5 L5.9,2.7 A0.6,0.6 0 0 0 5,3.2 Z"
            Visibility="{x:Bind local:TransportBar.PlayIconVisibility(Player.IsPlaying), Mode=OneWay, FallbackValue=Visible}" />
          <PathIcon
            x:Name="PauseIcon"
            Data="F1 M4.8,3 H5.7 A0.8,0.8 0 0 1 6.5,3.8 V12.2 A0.8,0.8 0 0 1 5.7,13 H4.8 A0.8,0.8 0 0 1 4,12.2 V3.8 A0.8,0.8 0 0 1 4.8,3 Z M10.3,3 H11.2 A0.8,0.8 0 0 1 12,3.8 V12.2 A0.8,0.8 0 0 1 11.2,13 H10.3 A0.8,0.8 0 0 1 9.5,12.2 V3.8 A0.8,0.8 0 0 1 10.3,3 Z"
            Visibility="{x:Bind local:TransportBar.PauseIconVisibility(Player.IsPlaying), Mode=OneWay, FallbackValue=Collapsed}" />
        </Grid>
      </Viewbox>
    </Button>

    <local:Scrubber
      x:Name="ScrubberBar"
      Grid.Column="1"
      VerticalAlignment="Center" />

    <TextBlock
      x:Name="CounterText"
      Grid.Column="2"
      VerticalAlignment="Center"
      AutomationProperties.Name="{x:Bind Player.CounterName, Mode=OneWay, FallbackValue=''}"
      Style="{StaticResource CaptionSecondaryTextStyle}"
      Text="{x:Bind Player.CounterText, Mode=OneWay, FallbackValue=''}" />
    <TextBlock
      x:Name="TimecodeText"
      Grid.Column="3"
      VerticalAlignment="Center"
      AutomationProperties.Name="{x:Bind Player.TimecodeName, Mode=OneWay, FallbackValue=''}"
      Style="{StaticResource CaptionSecondaryTextStyle}"
      Text="{x:Bind Player.TimecodeText, Mode=OneWay, FallbackValue=''}" />
  </Grid>
</UserControl>
