<?xml version="1.0" encoding="utf-8"?>
<!--
  The filmstrip (#20; DESIGN.md, Filmstrip; prototype docs/design/canvas/Main.dc.html, Filmstrip): every frame of the
  project as a 3:2 thumbnail, 4 px apart, in one row that scrolls sideways, and the caption row under it ("Frame 0312 of
  0742" on the left; the file name and capture time, then the thumbnail size slider, on the right), 8 px below.

  The row is an ItemsRepeater in a ScrollViewer, so only the thumbnails near the view exist as elements: 5,000 frames
  cost what 50 do. The repeater sits 6 px inside the scroller so the rings and the system focus ring, which draw up to
  6 px outside a thumbnail (FocusVisualMargin), are not clipped at the top and bottom. Pointer, keys, drag and the thumbnails' pictures are FilmstripView.xaml.cs's; the states a
  thumbnail draws are FilmstripThumb.xaml's.

  The size slider is a setting, not an indicator, so it is neutral here (Ink Secondary), not the app's amber slider.
-->
<UserControl
  x:Class="TenLapse.Filmstrip.FilmstripView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:filmstrip="using:TenLapse.Presentation.Filmstrip"
  xmlns:local="using:TenLapse.Filmstrip"
  xmlns:presentation="using:TenLapse.Presentation">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource InkSecondaryColor}" />
          <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource InkColor}" />
          <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource InkColor}" />
          <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource InkSecondaryColor}" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource InkColor}" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource InkColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource InkSecondaryColor}" />
          <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource InkColor}" />
          <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource InkColor}" />
          <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource InkSecondaryColor}" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource InkColor}" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource InkColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid RowSpacing="{StaticResource SpacingSm}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <local:FilmstripList x:Name="ListHost" Background="Transparent">
      <!-- Right-click or the context menu key: the same actions as Delete, Alt+Left, Alt+Right and Ctrl+Z. -->
      <local:FilmstripList.ContextFlyout>
        <MenuFlyout x:Name="StripMenu">
          <MenuFlyoutItem
            AutomationProperties.AcceleratorKey="{x:Bind presentation:ProjectText.FilmstripRemoveKeys}"
            Click="OnMenuRemoveClick"
            Command="{x:Bind ViewModel.RemoveCommand, Mode=OneWay}"
            KeyboardAcceleratorTextOverride="{x:Bind presentation:ProjectText.FilmstripRemoveKeys}"
            Text="{x:Bind presentation:ProjectText.FilmstripRemove}">
            <MenuFlyoutItem.Icon>
              <!-- Segoe Fluent Icons "Delete". -->
              <FontIcon Glyph="&#xE74D;" />
            </MenuFlyoutItem.Icon>
          </MenuFlyoutItem>
          <MenuFlyoutItem
            AutomationProperties.AcceleratorKey="{x:Bind presentation:ProjectText.FilmstripMoveEarlierKeys}"
            Command="{x:Bind ViewModel.MoveEarlierCommand, Mode=OneWay}"
            KeyboardAcceleratorTextOverride="{x:Bind presentation:ProjectText.FilmstripMoveEarlierKeys}"
            Text="{x:Bind presentation:ProjectText.FilmstripMoveEarlier}" />
          <MenuFlyoutItem
            AutomationProperties.AcceleratorKey="{x:Bind presentation:ProjectText.FilmstripMoveLaterKeys}"
            Command="{x:Bind ViewModel.MoveLaterCommand, Mode=OneWay}"
            KeyboardAcceleratorTextOverride="{x:Bind presentation:ProjectText.FilmstripMoveLaterKeys}"
            Text="{x:Bind presentation:ProjectText.FilmstripMoveLater}" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem
            AutomationProperties.AcceleratorKey="{x:Bind presentation:ProjectText.FilmstripUndoKeys}"
            Command="{x:Bind ViewModel.UndoCommand, Mode=OneWay}"
            KeyboardAcceleratorTextOverride="{x:Bind presentation:ProjectText.FilmstripUndoKeys}"
            Text="{x:Bind ViewModel.UndoText, Mode=OneWay}">
            <MenuFlyoutItem.Icon>
              <!-- Segoe Fluent Icons "Undo". -->
              <FontIcon Glyph="&#xE7A7;" />
            </MenuFlyoutItem.Icon>
          </MenuFlyoutItem>
        </MenuFlyout>
      </local:FilmstripList.ContextFlyout>

      <ScrollViewer
        x:Name="Scroller"
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Enabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled"
        ZoomMode="Disabled">
        <ItemsRepeater
          x:Name="Repeater"
          Margin="6"
          HorizontalAlignment="Left"
          TabFocusNavigation="Once">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="4" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="filmstrip:FilmstripItem">
              <local:FilmstripThumb />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <!-- While a drag reorders: a 2 px Ink bar in the seam where the frames will land. -->
      <Canvas x:Name="DragLayer" IsHitTestVisible="False">
        <Rectangle
          x:Name="InsertionMarker"
          Width="2"
          Fill="{ThemeResource InkBrush}"
          RadiusX="1"
          RadiusY="1"
          Visibility="Collapsed" />
      </Canvas>
    </local:FilmstripList>

    <Grid Grid.Row="1" ColumnSpacing="{StaticResource SpacingMd}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        x:Name="CaptionLabel"
        VerticalAlignment="Center"
        Foreground="{ThemeResource InkSecondaryBrush}"
        Style="{StaticResource CaptionTextStyle}"
        Text="{x:Bind ViewModel.CaptionText, Mode=OneWay}" />
      <TextBlock
        x:Name="FileLabel"
        Grid.Column="1"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Foreground="{ThemeResource InkSecondaryBrush}"
        Style="{StaticResource CaptionTextStyle}"
        Text="{x:Bind ViewModel.FileText, Mode=OneWay}"
        TextTrimming="CharacterEllipsis" />
      <!--
        The thumbnail height, 32 to 96 DIPs in 8 DIP steps (FilmstripViewModel.MinThumbnailHeight, MaxThumbnailHeight,
        ThumbnailHeightStep); the 32 px control overlaps the 8 px gap above and the stage padding below.
      -->
      <Slider
        x:Name="SizeSlider"
        Grid.Column="2"
        Width="96"
        Margin="0,-8,0,-8"
        VerticalAlignment="Center"
        AutomationProperties.Name="{x:Bind presentation:ProjectText.FilmstripThumbnailSize}"
        IsThumbToolTipEnabled="False"
        LargeChange="16"
        Maximum="96"
        Minimum="32"
        SmallChange="8"
        StepFrequency="8"
        Value="{x:Bind ViewModel.ThumbnailHeight, Mode=TwoWay}" />
    </Grid>
  </Grid>
</UserControl>
