<Project Sdk="Microsoft.NET.Sdk">
  <!-- Decode, draw and encode: Windows-only, on Win2D and the Windows media APIs. -->
  <PropertyGroup>
    <TargetFramework>$(TenLapseWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(TenLapseWindowsMinVersion)</TargetPlatformMinVersion>
    <!-- Strings/EncoderText.resx is English, the neutral language (#39). -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Win2D ships a native DLL per architecture, so Media builds per platform like the app. -->
    <Platforms>x64;ARM64</Platforms>
    <!-- CsWin32 generates the Media Foundation interop (NativeMethods.txt) as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TenLapse.Core\TenLapse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The encoder seam (IVideoEncoder) and the device check the Media tests skip on. -->
    <InternalsVisibleTo Include="TenLapse.Tests" />
  </ItemGroup>
</Project>
