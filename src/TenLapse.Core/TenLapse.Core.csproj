<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain net10.0: no UI or Windows types, so the model and timing code stay portable and fast to test. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- The unit tests pin the internal best-fraction search (Fraction.Nearest) directly. -->
    <InternalsVisibleTo Include="TenLapse.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Capture times from EXIF (#15): JPEG, HEIC and TIFF-based RAW, read from a stream, metadata only. -->
    <PackageReference Include="MetadataExtractor" />
  </ItemGroup>
</Project>
