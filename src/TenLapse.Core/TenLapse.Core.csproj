<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain net10.0: no UI or Windows types, so the model and timing code stay portable and fast to test. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The Strings/*.resx files are English, the neutral language (#39): English reads them from this assembly. For a regional English such as en-US, ResourceManager looks for a satellite once, finds none and remembers it. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <!-- The unit tests pin the internal best-fraction search (Fraction.Nearest) directly. -->
    <InternalsVisibleTo Include="TenLapse.Tests" />
  </ItemGroup>
</Project>
